rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 預設拒絕所有未明確許可的存取
    match /{document=**} {
      allow read, write: if false;
    }

    // 通用輔助函式
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 退回單數 classId：這是目前 Android（VocabViewModel.kt joinClass()/initFirebaseClassSync()）
    // 與 PWA（firebase-service.js joinClass()）實際程式碼都在用的欄位，兩邊都不是陣列。
    // 之前合併過一版 classIds 陣列，跟兩邊實際程式碼都對不上，已退回。
    function isClassMember(classId) {
      return isAuthenticated() && (
        getUserData().classId == classId ||
        getUserData().role == 'teacher' ||
        getUserData().role == 'admin' ||
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin'
      );
    }

    function isTeacherOrAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'teacher' ||
        getUserData().role == 'admin' ||
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin'
      );
    }

    // 2026-09-02 新增：座位帳號批次建立功能專用，刻意比 isTeacherOrAdmin() 更嚴格，
    // 只認 role === 'admin'（平台管理者本人），一般老師帳號不算在內。
    function isPlatformAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    // 1. 使用者個人資料 (users/{userId})
    // 注意：這裡的舊註解原本寫「Android 端用匿名登入」已經過時——2026-09-11 核對過目前
    // Android 的 registerUser()/loginUser()（VocabViewModel.kt）用的是跟 PWA 一樣的真正
    // Firebase Auth email/password 登入，uid 就是使用者本人，兩邊 App 若用同一組 email
    // 登入，uid 會是同一個。Android 另外有 GeminiService.fetchFirebaseIdToken()，在完全
    // 沒人登入時為了能呼叫查詞 API 會 fallback signInAnonymously()，但那個匿名 uid 只是
    // 裝置暫時性身分，換裝置或重灌就不見了，App 端邏輯不會把它當成使用者本人。
    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacherOrAdmin();

      // [安全性修正] 建立帳號時 role 欄位只能是預設值 student（或留空），不可自行指定 teacher/admin。
      // 已確認 Android registerUser()/Google 登入與 PWA signUp() 建立帳號當下都不會寫入 role 欄位，不影響現有功能。
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student');

      // [安全性修正] 原本「文件裡原本沒有 role 欄位就放行任何值」的漏洞（!('role' in resource.data)），
      // 會讓任何學生帳號自己把 role 設成 teacher 完成權限升級。
      // 這裡改成：沒有 role 欄位時，只允許補上 'student'（Android joinClass() 加入班級時會這樣寫，維持正常運作），
      // 不允許補上 teacher/admin；一般使用者也不可自行「更改」既有的 role。
      allow update: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        (!('role' in resource.data) && request.resource.data.role == 'student') ||
        request.resource.data.role == resource.data.role ||
        isTeacherOrAdmin()
      );

      // 1a.【PWA 專用】PWA 的生字庫 / 閱讀歷史紀錄。
      match /vocabWords/{wordId} {
        allow read, write: if isOwner(userId);
      }
      match /readHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }

      // 1b.【Android 專用，2026-09-11 新增】Android 端把本機 Room 的單字庫／閱讀進度同步上雲端，
      // 讓同一帳號換裝置也能接續進度（VocabViewModel.kt startVocabCloudSync()/migrateLocalVocabDataToCloud()）。
      // 刻意跟上面 PWA 的 vocabWords/readHistory 分開兩個 collection，避免兩邊 App 欄位格式不同
      // (Android 有 contextSentence/已讀頁碼 lastReadPage，PWA 有 phonetic) 互相覆蓋踩到對方資料。
      match /androidVocabWords/{wordId} {
        allow read, write: if isOwner(userId);
      }
      match /androidReadingProgress/{articleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. 班級主檔 (classes/{classId})
    // Android 目前程式碼裡沒有寫入這個父層文件的地方（開班是 admin.html 的職責），
    // 這裡開放 get 主要是給 PWA joinClass() 驗證班級代碼是否存在用。
    match /classes/{classId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow write: if isTeacherOrAdmin();

      // 2a. 班級作業資料 (classes/{classId}/assignments/{assignmentId})
      // Android 的 listenToAssignments() 跟 PWA 的 listenAssignments() 都是查這個路徑，欄位一致。
      match /assignments/{assignmentId} {
        allow read: if isClassMember(classId);
        allow create, update, delete: if isClassMember(classId) && isTeacherOrAdmin();
      }

      // 2b.【2026-09-23 新增】教材庫 (classes/{classId}/materials/{materialId})
      // 跟 assignments 不同：沒有繳交期限、沒有重點單字高亮，是老師批次上傳、學生自由選讀的
      // 文章庫（admin.html 批次上傳 UI，兩邊 App 學生端都有一個獨立的「教材庫」瀏覽分頁）。
      // 權限規則跟 assignments 完全比照辦理。
      match /materials/{materialId} {
        allow read: if isClassMember(classId);
        allow create, update, delete: if isClassMember(classId) && isTeacherOrAdmin();
      }
    }

    // 3. 公共單字庫快取 (public_dictionary/{wordId})
    // Android（fetchPublicDictSamples/searchPublicDictDirectly）與 PWA 都直接用 client SDK 讀這裡。
    match /public_dictionary/{wordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.word is string &&
        request.resource.data.word.size() > 0 &&
        request.resource.data.word.size() < 100 &&
        request.resource.data.translation is string &&
        request.resource.data.translation.size() < 1000;
    }

    // 4. 全局共享新聞與 AI 時事教材快取 (community_articles/{articleId})
    // ⚠️ 已知問題（見對話說明，非本檔案能解）：Android 跟 Cloud Function/PWA 寫入的文件
    // 格式不一樣（Android 攤平存 5 份文件，Cloud Function 存 1 份文件包 articles 陣列），
    // 導致「共用快取省 API 費用」實際上沒有共用到，需要另外對齊資料格式，不是規則問題。
    // 這裡的規則兩邊都能用，先維持通過。
    match /community_articles/{articleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.category is string &&
        request.resource.data.category.size() < 100 &&
        request.resource.data.dateString is string &&
        request.resource.data.dateString.size() < 50;
    }

    // 5.【PWA 專用】App/PWA 版本資訊 (app_config/versions)
    // Android 版本比對是走 Remote Config（另一個 Firebase 產品），不會讀這裡，純新增不影響 Android。
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 6.【2026-09-02 新增，B2B 座位帳號功能專用】補習班主檔 (schools/{schoolId})
    // 只有 seat-admin.html 的 Cloud Function（Admin SDK）會寫入，這裡的 write 規則
    // 刻意維持 false，一般用戶端完全不能寫，只開放平台管理者「讀」來做歷史查詢/下拉選單。
    match /schools/{schoolId} {
      allow get, list: if isPlatformAdmin();
      allow write: if false;
    }

    // 7.【2026-09-02 新增，B2B 座位帳號功能專用】座位帳號建立歷史紀錄 (seatBatches/{batchId})
    // ⚠️ 含明碼密碼，刻意只給 isPlatformAdmin() 讀，一般老師/學生帳號完全無法存取這個 collection。
    match /seatBatches/{batchId} {
      allow get, list: if isPlatformAdmin();
      allow write: if false;
    }
  }
}
